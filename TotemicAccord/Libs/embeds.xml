<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<!--
		Vendored libraries, pinned. See VERSIONS.md for exact versions/commits.
		Load order matters: LibStub first, then CallbackHandler, then anything
		that embeds them. LibDBIcon errors out at load time if LibDataBroker
		is not already registered, so LDB must precede it.
	-->
	<Script file="LibStub\LibStub.lua"/>
	<Include file="CallbackHandler-1.0\CallbackHandler-1.0.xml"/>

	<Include file="AceAddon-3.0\AceAddon-3.0.xml"/>
	<Include file="AceEvent-3.0\AceEvent-3.0.xml"/>
	<Include file="AceConsole-3.0\AceConsole-3.0.xml"/>
	<Include file="AceDB-3.0\AceDB-3.0.xml"/>
	<Include file="AceGUI-3.0\AceGUI-3.0.xml"/>
	<Include file="AceConfig-3.0\AceConfig-3.0.xml"/>

	<!--
		Private, renamed copies of AceGUI-3.0 and AceConfigDialog-3.0 (see VERSIONS.md).
		The shared AceGUI is used by other addons (Questie, RareScanner, OpenMap here) and
		recycles widgets between them, so theming it would leak into their windows. Our
		copy has its own name, widget pool and frame names, and is themed freely.
	-->
	<Include file="TotemicAccordGUI\TotemicAccordGUI.xml"/>
	<Script file="TotemicAccordConfigDialog\TotemicAccordConfigDialog.lua"/>

	<Script file="LibDataBroker-1.1\LibDataBroker-1.1.lua"/>
	<Include file="LibDBIcon-1.0\lib.xml"/>

	<Include file="LibSerialize\lib.xml"/>
	<Include file="LibDeflate\lib.xml"/>
</Ui>
